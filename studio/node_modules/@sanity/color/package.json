{
  "name": "@sanity/color",
  "version": "3.0.9",
  "description": "The Sanity color palette.",
  "keywords": [
    "color",
    "palette",
    "sanity"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/color/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/color.git",
    "directory": "packages/@sanity/color"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@sanity/tsdown-config": "^0.28.2",
    "@types/node": "^24.19.0",
    "rimraf": "^5.0.5",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "esm.sh": {
    "bundle": false
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "generate": "unrun scripts/generate.ts && pnpm --workspace-root exec oxfmt packages/@sanity/color/src/color.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  }
}